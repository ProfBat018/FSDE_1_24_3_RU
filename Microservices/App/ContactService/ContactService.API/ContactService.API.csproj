<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Grpc.AspNetCore" Version="2.71.0"/>
        
        <PackageReference Include="Grpc.Net.Client" Version="2.71.0"/>
        <PackageReference Include="Google.Protobuf" Version="3.31.1"/>
        <PackageReference Include="Grpc.Tools" Version="2.72.0"/>
        <PackageReference Include="AutoMapper" Version="12.0.1" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.4"/>
        <PackageReference Include="Scalar.AspNetCore" Version="2.6.2" />
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="../ContactService.Contracts/Protos/user.proto" GrpcServices="Client" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ContactService.Application\ContactService.Application.csproj" />
      <ProjectReference Include="..\ContactService.Contracts\ContactService.Contracts.csproj" />
      <ProjectReference Include="..\ContactService.Data\ContactService.Data.csproj" />
      <ProjectReference Include="..\ContactService.Infrastructure\ContactService.Infrastructure.csproj" />
    </ItemGroup>

</Project>
