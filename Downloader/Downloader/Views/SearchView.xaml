<UserControl x:Class="Downloader.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Downloader.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Grid Margin="5" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="0.15*"/>
            </Grid.ColumnDefinitions>
        
        
        <TextBox Grid.Row="0" Grid.Column="0" x:Name="UrlTextBox"
           md:HintAssist.Hint="Paste your link"
           VerticalAlignment="Center"
                 Text="{Binding URL, UpdateSourceTrigger=PropertyChanged}"
           Style="{StaticResource MaterialDesignOutlinedTextBox}"
           FontSize="16"
           Background="#f5f5f5"/>
        
        <Button  Grid.Row="0" Grid.Column="1" Content="{md:PackIcon Kind=Download, Size=32}"
                 Height="55"
          Style="{StaticResource MaterialDesignRaisedButton}"
          Background="#e53935"
          Foreground="White"
          VerticalAlignment="Center"
          Command="{Binding DownloadCommand}"
          />
            
        </Grid>

        <ListBox Grid.Row="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Image>
                            
                        </Image>
                        <TextBlock/>
                        <TextBlock/>
                        <ComboBox/>
                        <Button/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
      
    </Grid>
</UserControl>
